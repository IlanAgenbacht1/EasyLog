rules_version = '2';

service firebase.storage {
  match /b/ezl_bucket_01/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Timelogs path: timelogs/{timelogId}/signature.png or timelogs/{timelogId}/photos/photo_{index}.jpg
    match /timelogs/{timelogId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
